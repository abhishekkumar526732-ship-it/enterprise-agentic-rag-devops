# Application Settings
APP_NAME="Enterprise HR Policy Agentic RAG Copilot"
APP_ENV=development
ADMIN_API_KEY="enterprise-hr-super-secret-admin-key"

# LLM & Search API Keys
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"
TAVILY_API_KEY="your-tavily-api-key"

# Pinecone Vector DB
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="fde-hr-policy-rag"
PINECONE_NAMESPACE="company-hr-kb"
EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_MODEL="gpt-4o-mini"
TOP_K=4
MAX_RETRIES=1

# Enterprise Pillar 1: Model Gateway & Cost Control (LiteLLM)
LITELLM_MODEL="gpt-4o-mini"
LITELLM_FALLBACK_MODELS='["groq/llama-3.3-70b-versatile", "anthropic/claude-3-5-haiku-20241022"]'
LITELLM_MAX_BUDGET_USD=10.0
LITELLM_CACHE_ENABLED=true

# Enterprise Pillar 2: AI Security & Guardrails (Presidio & Safety Rails)
PII_MASKING_ENABLED=true
GUARDRAILS_ENABLED=true
CONFIDENTIAL_SALARY_MASKING=true

# Enterprise Pillar 3: AI Observability & Tracing (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY="your-langsmith-api-key"
LANGCHAIN_PROJECT="enterprise-hr-policy-copilot"

# Enterprise Pillar 4: Enterprise Identity & Access Control (Keycloak)
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL="http://localhost:8080"
KEYCLOAK_REALM="enterprise-hr"
KEYCLOAK_CLIENT_ID="hr-copilot-client"
KEYCLOAK_CLIENT_SECRET="your-keycloak-client-secret"

# Enterprise Redis (Response Caching, Session Memory, & Rate Limiting)
REDIS_ENABLED=true
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=3600
REDIS_RATE_LIMIT_PER_MINUTE=30
